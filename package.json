{
  "name": "@duongtdn/agent-cockpit",
  "version": "0.0.0",
  "description": "Drive coding agents, in their real terminal UI, from your app's own web UI.",
  "license": "MIT",
  "author": "duongtdn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duongtdn/agent-cockpit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "import": "./dist/fastify/index.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code/index.d.ts",
      "import": "./dist/claude-code/index.js"
    },
    "./channel": {
      "types": "./dist/channel/index.d.ts",
      "import": "./dist/channel/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:contract": "vitest run --project contract --reporter=default --reporter=./test/contract/results-reporter.ts",
    "test:browser": "vitest run --project browser",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:browser && pnpm test:contract && pnpm build && pnpm test:pack",
    "test:pack": "vitest run --project pack"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "8.23.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.332",
    "@biomejs/biome": "2.6.9",
    "@types/node": "22.20.7",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.2",
    "fastify": "5.12.8",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vitest": "5.1.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "fastify": "^5",
    "zod": "^4"
  }
}
